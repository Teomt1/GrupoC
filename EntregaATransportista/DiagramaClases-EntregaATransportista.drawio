        <mxCell id="ref1" value="«control»" style="rounded=0;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="90" height="22" as="geometry"/></mxCell>
        <mxCell id="reft1" value="Clase de control (modelo): reglas de negocio del caso de uso" style="text;html=0;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="830" width="600" height="22" as="geometry"/></mxCell>
        <mxCell id="ref2" value="«entidad»" style="rounded=0;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="858" width="90" height="22" as="geometry"/></mxCell>
        <mxCell id="reft2" value="Clase de entidad: datos que gestiona la aplicación" style="text;html=0;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="858" width="600" height="22" as="geometry"/></mxCell>
        <mxCell id="notas" value="+ público   - privado   / atributo derivado (se calcula a partir de otros)&#xa;Tipo{A, B}: el atributo solo toma esos valores (enum del código).&#xa;Rombo relleno (◆): composición; la parte no existe sin el todo y se elimina con él (Kendall pág. 306).&#xa;Los eventos del formulario reciben (sender, e); no se muestran para simplificar.&#xa;La interfaz no se relaciona directamente con las entidades (regla de Kendall y del profesor).&#xa;Nombres de clases, atributos y métodos tomados del código de la carpeta de la pantalla." style="text;html=0;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="892" width="900" height="106" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
