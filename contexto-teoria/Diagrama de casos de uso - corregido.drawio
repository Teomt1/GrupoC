        <mxCell id="sysTitle" value="&lt;b&gt;Sistema de Gestión de Depósito&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="115" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- Casos de uso (en infinitivo) -->
        <mxCell id="uc1" value="Recibir mercadería" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
