        <mxCell id="uc5" value="Empaquetar pedido y generar orden de entrega" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
